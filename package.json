{
  "name": "umiya-florist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:types": "node scripts/generate-types.mjs",
    "lint": "eslint src tests scripts next.config.ts",
    "format": "prettier --write src tests scripts docs *.ts *.mjs *.json README.md",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "check:release": "node scripts/check-release.mjs",
    "build:release": "npm run check:release && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@sentry/nextjs": "^11.8.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.80.0",
    "@tailwindcss/postcss": "^4.1.0",
    "fontkit": "^2.0.4",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
